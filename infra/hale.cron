# Installed to /etc/cron.d/hale by infra/deploy.sh.
# pg_dump and psql run INSIDE the postgres container (docker compose exec), so
# the host `postgres` in DATABASE_URL resolves on the compose network. Postgres
# publishes no port on the host. Do not run them with the host's own binaries.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV_FILE=/opt/hale/infra/.env
PG_DUMP=docker compose -f /opt/hale/infra/compose.yml exec -T postgres pg_dump
PSQL=docker compose -f /opt/hale/infra/compose.yml exec -T postgres psql
# Daily backup at 03:15 UTC; weekly shallow restore check on Sundays 04:00 UTC.
15 3 * * * root /opt/hale/infra/cron-run.sh backup /opt/hale/infra/backup.sh
0 4 * * 0 root /opt/hale/infra/cron-run.sh restore_check /opt/hale/infra/restore-check.sh --shallow
