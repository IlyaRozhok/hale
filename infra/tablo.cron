# Installed to /etc/cron.d/tablo by the deploy workflow.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV_FILE=/opt/tablo/infra/.env
PG_DUMP=docker compose -f /opt/tablo/infra/compose.yml exec -T postgres pg_dump
PSQL=docker compose -f /opt/tablo/infra/compose.yml exec -T postgres psql
# Daily backup at 03:15 UTC; weekly shallow restore check on Sundays 04:00 UTC.
15 3 * * * root /opt/tablo/infra/cron-run.sh backup /opt/tablo/infra/backup.sh
0 4 * * 0 root /opt/tablo/infra/cron-run.sh restore_check /opt/tablo/infra/restore-check.sh --shallow
