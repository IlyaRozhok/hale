 private final class TabBarDelegate: NSObject, UITabBarControllerDelegate {
   var onClick: ((_ index: Int?, _ identifier: String?) -> Bool)?
+  // Hale patch (react-native-bottom-tabs 1.5.0; drop on upgrade if upstream fixes it): `disablePageAnimations`
+  // only turns UIView animations off after JS hears of the switch, too late for the cross-fade iOS 26 starts at
