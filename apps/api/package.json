{
  "name": "@hale/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts src/db/mig.ts --bundle --packages=external --alias:@hale/contracts=../../packages/contracts/src/index.ts --platform=node --format=esm --target=node22 --outbase=src --outdir=dist",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mig:run": "tsx src/db/mig.ts run",
    "mig:revert": "tsx src/db/mig.ts revert"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@hale/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0"
  }
}
