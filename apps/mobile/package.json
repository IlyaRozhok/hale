{
  "name": "@hale/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:jest": "jest"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "1.5.0",
    "@hale/contracts": "workspace:*",
    "@hale/tokens": "workspace:*",
    "@react-native-community/slider": "5.2.1",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/native": "^7.5.1",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-persist-client": "^5.105.1",
    "expo": "^58.0.22",
    "expo-constants": "^58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-glass-effect": "~58.0.5",
    "expo-notifications": "^58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-bottom-tabs": "1.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "^19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.1",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/jest.setup.tsx"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@bottom-tabs|color))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.tsx"
    ]
  }
}
