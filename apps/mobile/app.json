{
  "expo": {
    "name": "Hale",
    "slug": "hale",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios"
    ],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.irozhok.hale",
      "supportsTablet": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
