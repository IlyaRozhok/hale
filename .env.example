# Copy to .env (git-ignored) and fill in. Placeholders only.
DATABASE_URL=postgres://tablo:tablo@localhost:5432/tablo
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
# argon2 hash of the owner password: `node -e "import('argon2').then(a=>a.default.hash(process.argv[1]).then(console.log))" 'your password'`
OWNER_PASSWORD_HASH=replace-with-argon2-hash
# monobank personal token; optional until the owner adds it (https://api.monobank.ua/)
MONOBANK_TOKEN=
PORT=3000
