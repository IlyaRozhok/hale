{
  "name": "tablo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:colors": "node scripts/check-raw-colors.mjs",
    "golden:classify": "pnpm --filter @tablo/api exec tsx ../../scripts/golden-classify.ts",
    "golden:import": "pnpm --filter @tablo/api exec tsx ../../scripts/golden-import.ts",
    "seed:private": "pnpm --filter @tablo/api exec tsx ../../scripts/seed-private.ts"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
